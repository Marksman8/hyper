# AURA environment configuration
# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
# Every variable here maps to a field in config/default.yaml via the
# AURA__<SECTION>__<FIELD> convention (see src/aura/config.py).

# --- Security -----------------------------------------------------------
# Shared secret for the local API. Generated on first run if left blank.
# Even though AURA binds to loopback only, any process on this machine can
# reach it, so the token is not optional.
AURA__SECURITY__API_TOKEN=

# --- Model server -------------------------------------------------------
# Which provider to build. `openai_compat` talks to any OpenAI-compatible
# server (llama.cpp, Ollama, vLLM-in-WSL, LM Studio). `echo` is a stub
# backend needing no GPU and no weights - useful before the model is
# downloaded, and proof that the seam holds.
AURA__LLM__PROVIDER=openai_compat

# Base URL of the inference server. AURA never imports a model library.
AURA__LLM__BASE_URL=http://127.0.0.1:8081/v1
AURA__LLM__API_KEY=
AURA__LLM__MODEL=default

# --- AURA API -----------------------------------------------------------
AURA__API__HOST=127.0.0.1
AURA__API__PORT=8760

# --- Logging ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
AURA__LOGGING__LEVEL=INFO
# console | json
AURA__LOGGING__FORMAT=console
